# Environment Variables for TrimFlow AI
# Copy this file to .env.local

# Supabase (PostgreSQL with RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Meta WhatsApp Cloud API
WHATSAPP_API_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# Gemini AI (Style Consultant & No-Show Predictor)
GEMINI_API_KEY=your-gemini-api-key

# EcoCash & InnBucks Integration Keys (Simulated / Live)
INNBUCKS_API_KEY=your-innbucks-key
ECOCASH_API_KEY=your-ecocash-key
